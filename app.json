{
  "expo": {
    "name": "STTS",
    "slug": "hossein-stts",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["android"],
    "android": {
      "package": "com.hossein.stts",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_SPECIAL_USE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "plugins": [
      "expo-router",
      ["expo-camera", { "cameraPermission": "برای اسکن متن، دسترسی به دوربین لازم است." }],
      "./modules/vosk-module/expo-plugin.js",
      "./modules/overlay-module/expo-plugin.js",
      "./modules/piper-module/expo-plugin.js",
      "./modules/tesseract-module/expo-plugin.js",
      "./modules/typing-module/expo-plugin.js"
    ],
    "scheme": "stts",
    "extra": {
      "router": { "origin": false },
      "eas": { "projectId": "ab6c79e2-2589-421b-8068-93fdbcd2b4fa" }
    }
  }
}
